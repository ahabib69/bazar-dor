# database (MongoDB Atlas connection string, keep the database name)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/bazar_dor?retryWrites=true&w=majority

# better auth
# generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=put_a_long_random_string_here
# local: http://localhost:3000   vercel: https://your-app-name.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# google oauth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# products api (this is the assignment api, change it here if it changes)
NEXT_PUBLIC_API_BASE_URL=https://api.api-store.workers.dev/api/bazardor
